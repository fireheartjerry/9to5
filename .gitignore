# 9to5 — never commit secrets or runtime data
.env
venv/
logs/
vault/
state/tasks/
state/control/
# SIE Experience Ledger (runtime SQLite, accumulates per run)
state/experience.db
state/experience.db-wal
state/experience.db-shm
__pycache__/
*.pyc
.pytest_cache/
test-run/
test-run2/
test-run3/
.sc-ctx/
CLAUDE.md.bak
# stray dir created when run on non-Windows (config paths default to C:\supercritical);
# the backslash is escaped so the literal directory name matches on Linux
C:\\supercritical/
