# 9to5 — never commit secrets or runtime data
.env
venv/
logs/
vault/
state/tasks/
state/control/
# SIE Experience Ledger (runtime SQLite, accumulates per run)
state/experience.db
state/experience.db-wal
state/experience.db-shm
# SIE runtime artifacts (LoRA adapters, datasets, sie state)
state/adapters/
state/sie_state.json
# Phase 2 second brain (Gemini): trust telemetry log
state/adversary_trust.jsonl
state/audit.jsonl
# Leftover ChatGPT Chromium profile from the pre-Gemini browser layer (runtime data; safe to delete)
state/chatgpt_profile/
# Scratch dumps
layer_dump.txt
__pycache__/
*.pyc
.pytest_cache/
test-run/
test-run2/
test-run3/
.sc-ctx/
CLAUDE.md.bak
# stray dir created when run on non-Windows (config paths default to C:\supercritical);
# the backslash is escaped so the literal directory name matches on Linux
C:\\supercritical/
.superpowers/
# Auto-generated navigation files — regenerate with: python tools/repo_map.py
# The .agents/ and .claude/ plugin AGENTS.md files are NOT generated by repo_map.py and stay tracked.
**/AGENTS.md
!.agents/**
!.claude/**
