# ============================================================================
# Second-instance Nightclaw bot — SEPARATE Discord application/token
# ============================================================================
# Copy this file to `.env.nightclaw2` (already gitignored) and fill in values
# from a SECOND Discord app (Developer Portal -> New Application -> Bot).
# Do NOT reuse the live bot's token — a second gateway on the same token
# double-handles every event in your production server.
#
# Bot setup checklist (once, in the Discord Developer Portal):
#   1. New Application -> Bot -> Reset Token -> copy the token below.
#   2. Bot -> Privileged Gateway Intents -> enable "MESSAGE CONTENT INTENT".
#   3. OAuth2 -> URL Generator -> scopes: bot + applications.commands;
#      bot permissions: Send Messages, Embed Links, Read Message History,
#      Manage Messages (for pin), Add Reactions. Open the URL, invite it to a
#      server you control (ideally a fresh test server / channel).
#   4. Right-click the target channel -> Copy Channel ID.
#   5. (optional) Right-click your server -> Copy Server ID for instant slash sync.
#   6. (optional) Right-click yourself -> Copy User ID to be the owner.
# ============================================================================

# REQUIRED — the SECOND app's bot token (NOT your live token)
DISCORD_BOT_TOKEN=paste_second_bot_token_here

# REQUIRED — channel ID this instance posts to / listens in (a test channel)
DISCORD_CHANNEL_ID=000000000000000000

# OPTIONAL — server ID for instant (~seconds) slash-command sync; 0 = global (~1h)
DISCORD_GUILD_ID=0

# OPTIONAL — your user ID; only this user may issue owner-gated control commands
DISCORD_HUMAN_USER_ID=
