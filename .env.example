# ============================================================================
# 9TO5 COMPLETE ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and customize for your setup.
# All values shown are defaults if not specified.
#
# Format:
# - BOOL: true/false (or yes/no, 1/0, on/off)
# - INT: integer numbers
# - FLOAT: decimal numbers
# - STR: string values
# ============================================================================

# ============================================================================
# PATHS & DIRECTORIES (auto-detected — override only if your layout differs)
# ============================================================================

# Repo root (default: directory containing this .env)
PROJECT_ROOT=C:\9to5

# Durable install root — home for vault/logs/knowledge across reinstalls
INSTALL_ROOT=C:\9to5

# Log directory (default: PROJECT_ROOT/logs)
LOG_PATH=C:\9to5\logs

# Living Claude Code knowledge base directory (default: INSTALL_ROOT/knowledge)
KNOWLEDGE_DIR=C:\9to5\knowledge

# Obsidian vault root (default: PROJECT_ROOT/vault)
OBSIDIAN_VAULT_PATH=C:\9to5\vault

# LoRA adapter output directory (default: PROJECT_ROOT/state/adapters)
LORA_OUTPUT_DIR=state/adapters

# (Optional) Branding icon URL used in Discord embeds/webhook avatars
BRAND_ICON_URL=


# ============================================================================
# REQUIRED: DISCORD BOT CREDENTIALS
# ============================================================================
# Get these from Discord Developer Portal → Applications → Your App

# The bot's authentication token (NOT your user token)
DISCORD_BOT_TOKEN=your_bot_token_here

# The Discord channel ID where 9to5 posts updates and receives commands
# Format: numeric channel ID (right-click channel → Copy Channel ID)
DISCORD_CHANNEL_ID=123456789012345678

# (Optional) User ID to @-ping for critical events (blocked, deadlock, abort)
DISCORD_HUMAN_USER_ID=987654321098765432

# (Optional) Guild/Server ID for instant slash-command registration
# Leave as 0 for global registration (can take ~1h to propagate)
DISCORD_GUILD_ID=0


# ============================================================================
# DISCORD BOT BEHAVIOR & FEATURES
# ============================================================================

# Enable lab-mode frontier features all at once (master switch)
DISCORD_LAB_MODE=false

# Use new Components V2 cockpit UI (modern) vs legacy embeds (classic)
DASHBOARD_CV2=true

# Enable multi-agent webhook personas ("The Cast")
CAST_MODE=false

# Enable /ask command + local Ollama war-room (experimental)
ASK_ENABLED=true

# Enable natural-language control via Discord messages (experimental, audited)
ASK_NL_CONTROL=false

# Use native Discord Polls for approval/gating
POLL_GATES=false

# Create a Discord forum thread per run (keeps runs organized)
RUN_THREADS=false

# Scheduled Event for the 9-5 working window (experimental)
SCHEDULED_EVENTS=false

# AutoMod safety rule on the control channel (experimental)
AUTOMOD_GUARD=false

# Enable emoji/reaction-based quick-approve
REACTION_APPROVE=true

# Monitor for orchestrator silence and alert (watchdog)
WATCHDOG_ENABLED=true

# Enable Pillow visual cards/charts/GIFs (degrades gracefully if missing)
VISUALS_ENABLED=true

# Cockpit visual theme: dark, neon, minimal, terminal
COCKPIT_THEME=dark

# Min interval (seconds) between cockpit hero-image uploads
COCKPIT_IMAGE_MIN_INTERVAL=30

# Enable night-mode (pauses runs during off-hours)
NIGHT_MODE=false

# Night-mode pause timeout (seconds) before resuming
NIGHT_MODE_PAUSE_TIMEOUT=600


# ============================================================================
# ORCHESTRATOR BRAIN (Local Ollama)
# ============================================================================

# Local Ollama model for the orchestrator brain
# Default: qwen2.5-coder:7b (code-specialized, fits 8GB VRAM)
# Alternatives: llama2, mistral, neural-chat, etc.
OLLAMA_MODEL=qwen2.5-coder:7b

# Ollama server URL (default: local)
OLLAMA_HOST=http://127.0.0.1:11434

# Timeout for Ollama calls (seconds) — prevents indefinite hangs
OLLAMA_TIMEOUT_SECONDS=180

# Context window size (CRITICAL: must be constant across all calls)
# 8192 = safe on 8GB VRAM with embedded model; raise only if GPU allows
OLLAMA_NUM_CTX=8192

# Reserved headroom for Ollama's response generation (tokens)
OLLAMA_GEN_HEADROOM=2048

# Keep-alive duration: prevent Ollama unloading between calls
# Format: Nd, Nh, Nm, or Ns (e.g., 30m, 2h)
OLLAMA_KEEP_ALIVE=30m


# ============================================================================
# EXECUTOR (Claude Code CLI)
# ============================================================================

# Timeout for Claude Code CLI calls (seconds)
# Typical: 9s trivial, 97s small edit, 500s heavy exploration
# 600s = safe margin
CLAUDE_CLI_TIMEOUT_SECONDS=600

# Inject the executor playbook (recipes/conventions) into Claude Code calls
EXECUTOR_PLAYBOOK_ENABLED=true

# Append 9to5's system prompt to Claude Code CLI invocations
EXECUTOR_APPEND_SYSTEM_PROMPT=true

# Parse Claude Code's --output-format json envelope (vs raw text)
EXECUTOR_OUTPUT_JSON=true

# Resume the same Claude session across subtask retries (vs fresh each time)
EXECUTOR_RESUME_RETRIES=true

# Seconds before the brain auto-approves a plan gate with no human response
PLAN_GATE_AUTO_APPROVE_SECONDS=8

# Pause duration (seconds) after hitting a Claude Pro session limit (default 5h)
SESSION_LIMIT_PAUSE_SECONDS=18000

# Max wait-and-retry attempts on a session rate limit before giving up
SESSION_LIMIT_MAX_RETRIES=3

# Timeout (seconds) for git/gh subprocess calls during PR creation
GIT_TIMEOUT_SECONDS=120


# ============================================================================
# MODEL ROUTING (Claude Code effort tiers → concrete model IDs)
# ============================================================================

MODEL_LOW=claude-haiku-4-5-20251001
MODEL_DEFAULT=claude-sonnet-4-6
MODEL_MEDIUM=claude-sonnet-4-6
MODEL_HIGH=claude-sonnet-4-6
MODEL_XHIGH=claude-opus-4-8
MODEL_ULTRACODE=claude-opus-4-8

# Cheap model for on-demand briefing / brain-dialogue (default: OLLAMA_MODEL)
BRIEF_MODEL=qwen2.5-coder:7b


# ============================================================================
# CLAUDE CODE KNOWLEDGE BASE (Live docs fetch)
# ============================================================================

# Fetch latest Claude Code docs at run start
CLAUDE_DOC_FETCH=true

# Timeout per doc fetch (seconds)
CLAUDE_DOC_TIMEOUT_SECONDS=8

# Parallel workers for doc fetch
CLAUDE_DOC_FETCH_WORKERS=10

# Total budget for entire doc scrape (seconds)
CLAUDE_DOC_FETCH_BUDGET_SECONDS=30

# Freshness guard: if cached docs < N hours old, skip web re-scrape
CLAUDE_KNOWLEDGE_MAX_AGE_HOURS=6

# Hard cap on compressed knowledge injection (chars)
CLAUDE_CAPABILITIES_MAX_CHARS=9000


# ============================================================================
# OBSIDIAN VAULT (Glass-box observability)
# ============================================================================

# API key for local Obsidian REST API
# Find in Settings → Community Plugins → Local REST API
OBSIDIAN_API_KEY=your_obsidian_rest_api_key

# Obsidian REST API port (default: 27124)
OBSIDIAN_PORT=27124

# Use HTTPS (secure, recommended)
OBSIDIAN_HTTPS=true

# Write notes synchronously + async Obsidian sync (faster teardown)
OBSIDIAN_ASYNC=true

# Reuse SQLite connections per thread (performance)
EXPERIENCE_POOL=true


# ============================================================================
# SELF-IMPROVEMENT ENGINE (SIE) — Core
# ============================================================================

# Enable automatic learning passes after every run
SIE_AUTO_MAINTENANCE=true

# Max seconds to wait for SIE maintenance to finish during teardown
SIE_MAINTENANCE_JOIN_SECONDS=180

# NUCLEAR: Revert brain to base model + freeze all promotions
SIE_KILL_SWITCH=false

# Tag for the brain model (champions stored as 9to5-brain:vN)
BRAIN_MODEL_TAG=9to5-brain

# Compute router for LoRA/DPO training: auto, cpu, gpu
SIE_COMPUTE=auto

# Auto-apply meta-optimizer knob tuning without human review
SIE_META_AUTOAPPLY=true

# Policy when autonomous escalation is needed but no human is present
# Options: block (safe default), allow, defer
AUTONOMOUS_DESTRUCTIVE_POLICY=block

# Comma-separated list of enabled MCP servers
MCP_SERVERS=github,gmail,google_calendar,google_drive,canva

# Comma-separated skills exempt from evolution pruning/archival
EVOLUTION_PINNED_SKILLS=architect-review,create-pr,deep-audit,deep-research


# ============================================================================
# SIE LAYER 0: EXPERIENCE LEDGER
# ============================================================================

# Record every run + subtask into the SQLite ledger (state/experience.db)
EXPERIENCE_LEDGER_ENABLED=true


# ============================================================================
# SIE LAYER 1: RETRIEVAL-AUGMENTED BRAIN (RAG-on-self)
# ============================================================================

# Local embedding model (used for k-NN retrieval)
EMBED_MODEL=nomic-embed-text

# Number of past successes to retrieve per spec
RETRIEVAL_K=5

# Max tokens for retrieval injection block
RETRIEVAL_MAX_TOKENS=350

# Cosine similarity floor (below this = irrelevant noise)
RETRIEVAL_MIN_SCORE=0.35

# Budget for solution-content injection (separate from metadata)
RETRIEVAL_CONTENT_MAX_TOKENS=700

# Approximate Nearest Neighbor index (faster k-NN, fail-open to linear scan)
ANN_INDEX_ENABLED=false

# ANN backend: chroma, milvus, or others
ANN_INDEX_BACKEND=chroma

# ANN index directory
ANN_INDEX_DIR=state/exp_index

# Embedding dimension (nomic-embed-text = 768, must match chosen model)
ANN_EMBED_DIM=768

# Retrieval rerank weights (recency, importance, relevance)
RETRIEVAL_W_RECENCY=0.5
RETRIEVAL_W_IMPORTANCE=3.0
RETRIEVAL_W_RELEVANCE=2.0

# Recency decay half-life (days)
RETRIEVAL_RECENCY_HALFLIFE_DAYS=14


# ============================================================================
# SIE LAYER 2: CONSOLIDATION ("Sleep-time" learning)
# ============================================================================

# Mine the ledger for lessons nightly (off-run, best-effort)
REFLECTION_CONSOLIDATE_ENABLED=false

# Min subtask count before a lesson is emitted
LESSONS_MIN_SUPPORT=3

# Win-rate gap threshold for emitting a lesson (0.0-1.0)
LESSONS_WIN_GAP=0.2


# ============================================================================
# SIE LAYER 2b: HIERARCHICAL CONTEXT COMPACTION
# ============================================================================

# Summarize old half of context when token ratio exceeds trigger
COMPACTION_ENABLED=false

# Trigger compaction when payload reaches this ratio of num_ctx (0.0-1.0)
COMPACTION_TRIGGER_RATIO=0.85

# Reserve this ratio of context for new content after compaction
COMPACTION_RESERVE_RATIO=0.4

# Minimum tokens to reserve (floor)
COMPACTION_RESERVE_FLOOR=1024

# Max compaction passes per spec (avoid thrashing)
COMPACTION_MAX_PASSES=3

# Directory for offloaded context
COMPACTION_OFFLOAD_DIR=state/compaction


# ============================================================================
# SIE LAYER 3: PROMPT EVOLUTION (Versioned prompts + A/B testing)
# ============================================================================

# Min field uses before evaluating a prompt variant
PROMPT_PROMOTE_MIN_USES=20

# Z-score threshold for statistical promotion (1.64 = ~95% confidence)
PROMPT_PROMOTE_Z=1.64


# ============================================================================
# SIE LAYER 4: POLICY LEARNING (Effort/model/skill routing)
# ============================================================================

# Contextual bandit reward weights
# Tunable: 1st_pass rate, attempt count, cost, wallclock time


# ============================================================================
# SIE LAYER 5: LOCAL LoRA DISTILLATION (Weight fine-tuning)
# ============================================================================

# Min gold examples before training a LoRA (prevent overfitting)
LORA_MIN_EXAMPLES=50

# LoRA rank (higher = more expressive, slower training)
LORA_RANK=16

# LoRA training epochs
LORA_EPOCHS=2

# DPO (preference) optimization KL-beta weight
DPO_KL_BETA=0.1

# Min DPO preference pairs before training
DPO_MIN_PAIRS=30


# ============================================================================
# SIE LAYER 6+: REFLECTION & CONFIDENCE
# ============================================================================

# Ask Claude to reflect on & learn from each subtask (off-run)
SIE_REFLECTION_ENABLED=true

# Inject reflection-based authoring context into next brain calls
SIE_AUTHORING_CONTEXT=true

# Confidence / deferral threshold (when to escalate to Claude)
CONFIDENCE_DEFER_THRESHOLD=0.4

# Budget for triggering insights/consolidation
INSIGHT_TRIGGER_BUDGET=3.0


# ============================================================================
# SIE LAYER 7: SKILL EVOLUTION
# ============================================================================

# Propose new skills/playbook improvements after qualifying runs
EVOLUTION_ENABLED=false

# Consolidate evolution insights (mine failure patterns)
EVOLUTION_CONSOLIDATE=false

# Escalate improvements to Claude for expensive review
EVOLUTION_ESCALATE=false

# Fraction of runs to use as canaries for new skills
EVOLUTION_CANARY_FRACTION=0.1

# Min failures before escalating to Claude review
EVOLUTION_ESCALATE_MIN_FAILS=3

# Mark a skill stale if not used for N days
EVOLUTION_STALE_DAYS=30

# Archive candidate after N days of no promotion
EVOLUTION_ARCHIVE_DAYS=90


# ============================================================================
# SIE LAYER 8: SELF-PLAY CURRICULUM
# ============================================================================

# Enable self-generated goal curriculum (explore weak areas)
SELFPLAY_ENABLED=true

# Max self-play runs per day
SELFPLAY_MAX_PER_DAY=3

# Duration per self-play run (hours)
SELFPLAY_HOURS=1

# Self-play window start (hour of day, 24h format)
SELFPLAY_START_HOUR=9

# Self-play window end (hour of day, 24h format)
SELFPLAY_END_HOUR=17

# Bootstrap SIE from prior runs on first start
SIE_BOOTSTRAP=true


# ============================================================================
# PREDICTIVE FLAGS & INSTINCT FACULTY
# ============================================================================

# Heuristic predictive-flags toggle (surface likely-risk before it happens)
PREDICTIVE_FLAGS_ENABLED=true

# Ask Ollama for a natural-language explanation of predictive flags
PREDICTIVE_FLAG_OLLAMA=false

# Min seconds between predictive-flag checks
PREDICTIVE_FLAG_MIN_INTERVAL_SECONDS=90

# Enable instinct checks (gut feeling when something seems off)
INSTINCT_ENABLED=true

# Instinct check interval (seconds, default ~15 min)
INSTINCT_INTERVAL_SECONDS=900


# ============================================================================
# EVALUATION & FITNESS
# ============================================================================

# Fitness function weights (all must sum to 1.0)
# first_pass_rate: quality on first attempt
# attempts: penalize retries
# cost: penalize API cost
# plan_stability: consistency of plans
# challenge_rate: penalize adversary challenges
# (Tuned via ENV is a future feature; currently hardcoded in eval_harness.py)


# ============================================================================
# EXECUTOR: DURABILITY & RETRIES
# ============================================================================

# Max automatic restarts on crash/failure
RUN_MAX_RESTARTS=5

# Max backoff time between restarts (seconds)
RUN_RESTART_MAX_BACKOFF=300

# Stall detection timeout: abort if no progress (seconds)
RUN_STALL_SECONDS=1800


# ============================================================================
# GEMINI SECOND-BRAIN (Optional Claude-Code-like reviewer)
# ============================================================================

# Gemini API key (enables second-brain architecture for review)
GEMINI_API_KEY=your_gemini_api_key_here

# Auto-detect GEMINI_ENABLED from key presence (override with explicit bool)
GEMINI_ENABLED=true

# Gemini model name
GEMINI_MODEL=gemini-2.5-flash

# Gemini call timeout (milliseconds)
GEMINI_TIMEOUT_MS=120000

# Max conversation turns before rollover to fresh session
GEMINI_MAX_TURNS=40

# Min output length to avoid trivial responses (cost guard)
GEMINI_MIN_OUTPUT_CHARS=200

# Retries for JSON repair on Gemini output
GEMINI_JSON_REPAIR_RETRIES=1

# Retries for health probes on Gemini
GEMINI_HEALTH_PROBE_RETRIES=2


# ============================================================================
# PRE-EXECUTION COUNCIL (production wiring is opt-in)
# ============================================================================

ENABLE_PRE_EXECUTION_COUNCIL=false
PRE_EXECUTION_COUNCIL_SEAM_ENABLED=false
PRE_EXECUTION_COUNCIL_RUN_ON_RESUME=false
PRE_EXECUTION_COUNCIL_STRICT_MODE=false
PRE_EXECUTION_COUNCIL_INJECT_ARCHITECT_CONTEXT=false
PRE_EXECUTION_COUNCIL_INJECT_PLANNER_CONTEXT=false
PRE_EXECUTION_COUNCIL_MAX_INJECTED_CHARS=2500

PRE_EXECUTION_COUNCIL_CONVERSATION_POLICY=selector
PRE_EXECUTION_COUNCIL_SELECTOR_DEBATE_ROUNDS=1
PRE_EXECUTION_COUNCIL_MESSAGES_PER_SEAT=1
PRE_EXECUTION_COUNCIL_TOTAL_TARGET_MESSAGES=5
PRE_EXECUTION_COUNCIL_LOGGING_ENABLED=true
PRE_EXECUTION_COUNCIL_OUTPUT_DIR=state/council_runs
PRE_EXECUTION_COUNCIL_TRANSCRIPT_MODE=full
PRE_EXECUTION_COUNCIL_COMPACT_PROTOCOL=true
PRE_EXECUTION_COUNCIL_ANTI_FILLER=true
PRE_EXECUTION_COUNCIL_MOCK_SEATS_ENABLED=true

ENABLE_PRE_EXECUTION_COUNCIL_GEMINI=false
ENABLE_PRE_EXECUTION_COUNCIL_LOCAL=false
PRE_EXECUTION_COUNCIL_LOCAL_MODEL=qwen2.5-coder:7b

ENABLE_PRE_EXECUTION_COUNCIL_GROQ=false
PRE_EXECUTION_COUNCIL_GROQ_MODEL=qwen/qwen3-32b
PRE_EXECUTION_COUNCIL_GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-20b
GROQ_API_KEY=

ENABLE_PRE_EXECUTION_COUNCIL_CLOUDFLARE=false
PRE_EXECUTION_COUNCIL_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_AI_API_KEY=

ENABLE_PRE_EXECUTION_COUNCIL_CEREBRAS=false
PRE_EXECUTION_COUNCIL_CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_API_KEY=

ENABLE_PRE_EXECUTION_COUNCIL_GPT_BROWSER=false
PRE_EXECUTION_COUNCIL_GPT_PROJECT_URL=https://chatgpt.com/g/g-p-6a3b5bc2c1708191b67f1546ae6468d8-9to5/project
PRE_EXECUTION_COUNCIL_GPT_MODEL=GPT-5.5
PRE_EXECUTION_COUNCIL_GPT_REASONING=Medium


# ============================================================================
# ADVERSARY REVIEW (Quality gates)
# ============================================================================

# Run adversary review on plan quality
ADVERSARY_REVIEW_PLAN=true

# Run adversary review on architecture/design
ADVERSARY_REVIEW_ARCH=true

# Gemini reviews the pre-PR diff before it goes out
ADVERSARY_REVIEW_PREPR_DIFF=true

# Consult Gemini for a second opinion on low-confidence decisions
ADVERSARY_LOWCONF_CONSULT=true

# Max diff chars sent to adversary review
ADVERSARY_PREPR_DIFF_MAX_CHARS=12000

# Severity that holds a PR + drives remediation: low, medium, high
ADVERSARY_BLOCKING_SEVERITY=high

# Max bounded remediation attempts before giving up
ADVERSARY_REMEDIATION_MAX_ATTEMPTS=2

# Enable the adversary remediation loop (fix-and-recheck)
ADVERSARY_REMEDIATION=true

# Enable the adversary PR-hold gate
ADVERSARY_PR_HOLD=true


# ============================================================================
# HUMAN-NATURE LAYER (Cognitive architecture — OFF by default)
# ============================================================================

# Master switch: enable the cognitive/sentience layer
HUMAN_NATURE_ENABLED=false

# Behavioral flags (OFF until A/B validates them)
HN_OPINIONS_BEHAVIOR=false
HN_EMOTIONS_BEHAVIOR=false
HN_INTUITION_SHORTCUT=false

# Opinion veto conviction thresholds
HN_THETA_SOFT=0.60        # soft-vote floor
HN_THETA_HARD=0.85        # hard-veto floor

# Recalibration temperature for overconfidence correction
HN_RECAL_TEMPERATURE=2.5

# Fast model for human-nature faculties (lower than main brain)
HN_FAST_MODEL=qwen2.5:1.5b


# ============================================================================
# ADVANCED EPICS 1 & 2: OBSERVABILITY, RESUME, PLANNING (newer, free to run)
# ============================================================================

# Epic 1: record a step-by-step trajectory for every run
TRAJECTORY_ENABLED=true

# Epic 1: enforce a hard USD ceiling on a run (0.0 = no cap)
COST_BUDGET_ENABLED=false
COST_BUDGET_CEILING_USD=0.0

# Epic 1: write a resumable step journal
STEP_JOURNAL_ENABLED=true

# Epic 1: resume from the last completed step instead of restarting a subtask
STEP_RESUME_ENABLED=false

# Epic 1: isolate each subtask in its own git worktree
WORKTREE_ISOLATION_ENABLED=true

# Bounded concurrent work: requested values are reduced by CPU-aware limits.
DEFAULT_PARALLELISM=3
PARALLEL_SUBTASKS_MAX=3
HEALTH_CHECK_MAX_WORKERS=4

# Epic 2: dual-ledger planner (ships dark upstream — enable only once stable)
DUAL_LEDGER_PLANNER_ENABLED=false

# Epic 2: execution-grounded independent verifier (re-checks claimed results)
INDEPENDENT_VERIFY_ENABLED=true

# Epic 2: attach an evidence receipt to each verification
EVIDENCE_RECEIPT_ENABLED=true

# Max JSON self-correction re-prompt attempts on malformed brain output
BRAIN_JSON_RETRY_MAX=2

# Consecutive stalls before triggering a root-cause replan
STALL_THRESHOLD=2


# ============================================================================
# ADVANCED EPIC 5: AGENT SOCIETY (multi-agent workforce — SPENDS API $)
# ============================================================================
# Spins up researcher/coder/tester/reviewer/planner Claude Code subprocesses.
# Uses your existing Claude Code CLI auth — no separate API key needed.
# Cost is bounded by SOCIETY_TOKEN_BUDGET_USD per run.

SOCIETY_ENABLED=false
SOCIETY_MAX_WORKERS=3
SOCIETY_DEBATE_MAX_ROUNDS=3
SOCIETY_TOKEN_BUDGET_USD=5.0
SOCIETY_MODEL_RESEARCHER=low
SOCIETY_MODEL_CODER=high
SOCIETY_MODEL_TESTER=default
SOCIETY_MODEL_REVIEWER=high
SOCIETY_MODEL_PLANNER=default


# ============================================================================
# ADVANCED EPIC 6: SOLUTION-SPACE FORKING (parallel branches — SPENDS API $)
# ============================================================================
# Runs N independent full attempts, judges/grafts the best.
# Uses your existing Claude Code CLI auth — no separate API key needed.
# Cost is bounded by SOLUTION_FORK_COST_CEILING_USD per run.

SOLUTION_FORK_ENABLED=false
SOLUTION_FORK_N=2
SOLUTION_FORK_MAX_CONCURRENCY=2
SOLUTION_FORK_COST_CEILING_USD=5.0
SOLUTION_FORK_BRANCH_COST_ESTIMATE_USD=1.0
SOLUTION_FORK_GRAFT_ENABLED=false
SOLUTION_FORK_W_FACT=0.5
SOLUTION_FORK_W_RUBRIC=0.3
SOLUTION_FORK_W_RISK=0.15
SOLUTION_FORK_W_COST=0.05


# ============================================================================
# ADVANCED EPIC 8: EXECUTION FABRIC (local/docker/remote backend — free on local)
# ============================================================================

# Master gate. When false, execution is always local (byte-for-byte legacy path)
EXECUTION_FABRIC_ENABLED=false

# Default backend: local, docker, remote
EXECUTION_BACKEND=local

# Docker image used when EXECUTION_BACKEND=docker (must have `claude` CLI baked in)
DOCKER_EXECUTOR_IMAGE=9to5-executor:latest

# Remote execution sub-strategy when EXECUTION_BACKEND=remote
EXECUTION_REMOTE_KIND=ssh

# Remote execution host (empty → healthcheck fails → falls back to local)
EXECUTION_REMOTE_HOST=

# Timeout (seconds) for provisioning a single backend
EXECUTION_PROVISION_TIMEOUT_SECONDS=120


# ============================================================================
# SEMANTIC SAFETY (Action-risk classification)
# ============================================================================

# Enable semantic safety gates (classify read/write/destructive/unknown)
SEMANTIC_SAFETY_ENABLED=false

# Autonomous spend budget (USD) — 0.0 = human approval required
AUTONOMY_ALLOWANCE_USD=0.0

# Autonomous destructive budget (USD) — 0.0 = never autonomous
AUTONOMOUS_DESTRUCTIVE_ALLOWANCE_USD=0.0

# Hint: estimated cost per Claude CLI attempt (for metering)
CLAUDE_ATTEMPT_COST_HINT_USD=0.0


# ============================================================================
# BROWSER LAYER (Computer-use capabilities — EXPERIMENTAL)
# ============================================================================

# Enable Chrome DevTools Protocol (CDP) browser automation
BROWSER_LAYER_ENABLED=false

# Enable native Windows UIA (UI Automation) layer
NATIVE_LAYER_ENABLED=false


# ============================================================================
# EXTERNAL INTEGRATIONS (Jerry advisor, watchdog, tunnels)
# ============================================================================

# Base URL of the local Jerry gate-decision HTTP service
JERRY_URL=http://127.0.0.1:8008

# Opt-in: consult Jerry's fine-tuned advisor model at plan gates (set to 1)
JERRY_ADVISOR=

# Opt-in: run Jerry in shadow/log-only mode at non-plan gates (set to 1)
JERRY_SHADOW=

# Seconds of silence on an active run before the watchdog flags it stale/hung
WATCHDOG_STALE_SECONDS=600

# ngrok auth token — presence gates whether the ngrok tunnel provider is usable
NGROK_AUTH_TOKEN=


# ============================================================================
# EMERGENCY ISOLATION SWITCHES
# ============================================================================

# Prevent self-modifying code (touching orchestrator.py, config.py, etc.)
SELFMOD_ALLOW_CORE=false


# ============================================================================
# DEVELOPMENT & TESTING (not needed for a normal run — dev/CI use only)
# ============================================================================

# Enable pytest heartbeat reporter for long-running test suites
# NINE_TO_FIVE_TEST_PROGRESS=1
# NINE_TO_FIVE_TEST_HEARTBEAT_SECONDS=30

# Opt out of the autouse sleep-capping fixture in tests
# NINE_TO_FIVE_REAL_SLEEP=false

# Opt out of the autouse fixture that blocks real Ollama calls in tests
# NINE_TO_FIVE_ALLOW_OLLAMA=false

# Number of random seeds for the control-plane chaos fuzz test
# NINE_TO_FIVE_FUZZ_SEEDS=24

# Disable ANSI color in trace-replay text rendering
# NO_COLOR=1
